# انسخ هذا الملف باسم .env وضع القيم الحقيقية. لا ترفع ملف .env إلى GitHub.

# قاعدة البيانات على Supabase (المستخدم prisma)
# على جهازك ولتحديث القاعدة (npm run db:deploy): Session pooler على المنفذ 5432
DATABASE_URL="postgresql://prisma.irfbruqsdoulnrtheloa:[PRISMA-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"
# على Netlify: Transaction pooler على المنفذ 6543 (نفس الرابط مع تغيير المنفذ)
# DATABASE_URL="postgresql://prisma.irfbruqsdoulnrtheloa:[PRISMA-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres"

# مفاتيح سرية عشوائية (32 حرفاً على الأقل). لتوليد واحد:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
OTP_SECRET=""

# Resend: المفتاح من resend.com ← API Keys
RESEND_API_KEY=""
# قبل توثيق دومينك: يرسل Resend فقط إلى بريد حسابك من هذا العنوان
EMAIL_FROM="Template Definition Requests <onboarding@resend.dev>"
